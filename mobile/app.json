{
  "expo": {
    "name": "AquaControl32-Mobile",
    "slug": "AquaControl32-Mobile",
    "owner": "lucasfornero",
    "version": "1.0.0",
    "scheme": "aquacontrol32",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lucas.aquacontrol32"
    },
    "android": {
      "package": "com.lucas.aquacontrol32",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_ADVERTISE",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["peripheral", "central"],
          "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to AquaControl32 over Bluetooth.",
          "bluetoothPeripheralPermission": "Allow $(PRODUCT_NAME) to connect to AquaControl32 over Bluetooth."
        }
      ],
      "expo-build-properties"
    ],
    "extra": {
      "eas": {
        "projectId": "e24eb940-09b1-4d8b-8e0a-d512ea492054"
      }
    }
  }
}
